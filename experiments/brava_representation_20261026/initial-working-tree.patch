+        axis.set_box_aspect((width, height, depth))
+        axis.view_init(elev=22, azim=-58)
+        axis.set_title(f"{title}\n{len(nodes)} nodes · {len(edges)} edges")
+    figure.savefig(path, dpi=180)
+    plt.close(figure)
